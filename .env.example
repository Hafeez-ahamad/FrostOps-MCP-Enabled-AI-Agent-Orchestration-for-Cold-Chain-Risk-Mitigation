# Copy to .env and replace every placeholder. Never commit .env.
# SQL Server passwords must meet its policy (8+ chars, mixed case, digit, symbol).
# Generate a fresh random password for every login; never reuse one across environments.

# --- SQL Server (Docker) ---
MSSQL_SA_PASSWORD=replace-me-sa-password
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_DATABASE=ColdChainDB
# One login per purpose (db/roles.sql); db-init creates them with these passwords.
SQL_AGENT_PASSWORD=replace-me-agent-password
SQL_INGEST_PASSWORD=replace-me-ingest-password
SQL_CONSOLE_PASSWORD=replace-me-console-password
# One login per agent role (spec section 10).
SQL_MONITOR_PASSWORD=replace-me-monitor-password
SQL_PLANNER_PASSWORD=replace-me-planner-password
SQL_GATE_PASSWORD=replace-me-gate-password
SQL_EXECUTOR_PASSWORD=replace-me-executor-password
# Accept the local container's self-signed certificate. Local development only.
SQL_TRUST_SERVER_CERTIFICATE=true

# --- LLM backend: OLLAMA (default, local) or OPENAI (hosted) ---
AGENT_LLM=OLLAMA
OLLAMA_MODEL=qwen2.5:7b
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
# Tokens all LLM roles may spend in one run (same for every configuration).
LLM_TOKEN_BUDGET_PER_RUN=200000

# --- SOP retrieval: LOCAL (offline, default) ---
SOP_BACKEND=LOCAL

# --- Live Open-Meteo weather adapter (off by default; never used in tests or replay) ---
CORRIDOR_LIVE_ENABLED=false

# --- Dispatch API (python -m api) ---
# Comma-separated user_id:role:depots:sha256_of_token (depots "*" or "DEP-LB|DEP-VER").
# Leave empty for throwaway demo users with random tokens printed at start.
API_USERS=
# Streamlit console: where the API runs, and the token to use.
CONSOLE_API_URL=http://127.0.0.1:8000
CONSOLE_API_TOKEN=
